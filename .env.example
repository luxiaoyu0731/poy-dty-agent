# Local development only. Do not use this file for Docker, staging, or production.
# The Docker image refuses to start with APP_ENV=development or ENFORCE_INTERNAL_TOKEN=0.
# Copy .env.production.example or .env.staging.example to .env for production-like compose runs.
#
# Only DEEPSEEK_API_KEY is required to enable real LLM answers locally.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
EVENT_SUMMARY_WORKER_CONCURRENCY=3
EVENT_SUMMARY_WORKER_BATCH_SIZE=5
EVENT_SUMMARY_WORKER_POLL_SECONDS=30
EVENT_SUMMARY_DAILY_REQUEST_LIMIT=50
EVENT_SUMMARY_DAILY_BUDGET_RMB=10
EVENT_SUMMARY_MAX_COST_PER_REQUEST_RMB=0.20
EIA_API_KEY=
FRED_API_KEY=
UN_COMTRADE_API_KEY=

# Local-safe defaults. Change only when deploying beyond local/staging.
APP_ENV=development
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,X-Internal-Token,X-Request-ID
OUTBOUND_FETCH_HOSTS=api.eia.gov,www.eia.gov,opec.org,www.opec.org,www.ine.cn,english.czce.com.cn,www.czce.com.cn,www.chinamoney.org.cn,www.chinamoney.com.cn,api.stlouisfed.org,www.cftc.gov,sanctionslist.ofac.treas.gov,sanctionslistservice.ofac.treas.gov,ofac.treasury.gov,home.treasury.gov,www.state.gov,www.consilium.europa.eu,www.ndrc.gov.cn,www.nea.gov.cn,www.ukmto.org,www.maritime.dot.gov,english.customs.gov.cn,comtradeapi.un.org,www.whitehouse.gov,press.un.org,www.iea.org,www.federalreserve.gov,www.imo.org,www.mpa.gov.sg,news.google.com,api.gdeltproject.org,www.sse.com.cn,www.szse.cn,www.hkexnews.hk,www.cninfo.com.cn,www.centcom.mil,www.defense.gov,www.war.gov,www.dvidshub.net,www.nato.int,ec.europa.eu,www.gov.uk,www.news.uscg.mil,www.aramco.com,www.adnoc.ae,www.qatarenergy.qa,www.sinopecgroup.com,www.sinopec.com,www.cnpc.com.cn,news.cnpc.com.cn,query1.finance.yahoo.com,hq.sinajs.cn,push2.eastmoney.com,www.sunsirs.com,www.cctd.com.cn,info.texnet.com.cn,www.tnc.com.cn,zh.tradingeconomics.com,earthquake.usgs.gov,www.tradingeconomics.com,www.100ppi.com,www.cnbc.com,oilprice.com,dlpoy.100ppi.com,dldty.100ppi.com,www.visualcapitalist.com,www.eastdaley.com
INDUSTRIAL_INTELLIGENCE_ENABLED=0
INTELLIGENCE_WRITE_RATE_LIMIT_PER_WINDOW=30
INTELLIGENCE_CURSOR_SECRET=
INTELLIGENCE_RUN_DIR=
MAX_CHAT_QUESTION_CHARS=1200
MAX_SOURCE_PREVIEW_CHARS=500
SQLITE_PATH=data/agent.db
# Local ONNX embedding. The model cache is runtime data and is not committed.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_VERSION=fastembed-0.7.4-mean-pooling
EMBEDDING_DIMENSIONS=384
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_FALLBACK_POLICY=hash_fallback
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
RAG_CHUNK_MAX_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=120
ENFORCE_INTERNAL_TOKEN=0
INTERNAL_API_TOKEN=
PUBLIC_AUTH_MODE=single_user_password
PUBLIC_LOGIN_PASSWORD_HASH=
PUBLIC_CANONICAL_ORIGIN=https://app.example.com
PUBLIC_SESSION_IDLE_TTL_SECONDS=3600
PUBLIC_SESSION_ABSOLUTE_TTL_SECONDS=43200
PUBLIC_LOGIN_WINDOW_SECONDS=900
PUBLIC_LOGIN_MAX_ATTEMPTS=5
PUBLIC_LOGIN_GLOBAL_MAX_ATTEMPTS=20
RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_PER_WINDOW=30
SOURCE_FETCH_RATE_LIMIT_PER_WINDOW=10
INTRADAY_PRICE_SCHEDULER_ENABLED=true
INTRADAY_PRICE_INTERVAL_SECONDS=300
INTRADAY_PRICE_INITIAL_DELAY_SECONDS=5

# Alerts. For personal WeChat, use ServerChan Turbo or PushPlus as a bridge.
ALERT_PUSH_PROVIDER=
SERVERCHAN_SENDKEY=
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
PUSHPLUS_TEMPLATE=markdown
WECHAT_WEBHOOK_URL=

# Frontend runtime API config.
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PREFIX=/api/v1

# Pipeline graph cost display: static USD->CNY anchor (display-only, budget settling stays native micro-USD)
USD_CNY_DISPLAY_RATE=7.25
# USD_CNY_FX_VERSION=usd-cny-static-2026-09@7.25

# Operator-approved live trial, independent rollback switches (default off).
# Effect acceptance is unknown; activation never bypasses source/time/citation gates.
AGENT_MEMORY_RECALL_ENABLED=0
AGENT_MEMORY_VOTING_ENABLED=0
AGENT_REFLECTION_BACKGROUND_ENABLED=0

# Total HTTP attempts (including connection failures and schema retries).
# Stage request quotas are 16/16/7/7/2; unused capacity is not spent automatically.
AGENT_CHAIN_DAILY_CAP=60
