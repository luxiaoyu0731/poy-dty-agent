# Copy to:
# ~/Library/Application Support/POY-DTY-Agent/shared/.env.production
# Never commit the populated file.
APP_ENV=production
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_VERSION=fastembed-0.7.4-mean-pooling
EMBEDDING_DIMENSIONS=384
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_FALLBACK_POLICY=hash_fallback
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
RAG_CHUNK_MAX_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=120
ENFORCE_INTERNAL_TOKEN=1
INTERNAL_API_TOKEN=
PUBLIC_AUTH_MODE=single_user_password
PUBLIC_LOGIN_PASSWORD_HASH=
PUBLIC_CANONICAL_ORIGIN=https://app.kaipingrc.com
PUBLIC_SESSION_IDLE_TTL_SECONDS=3600
PUBLIC_SESSION_ABSOLUTE_TTL_SECONDS=43200
PUBLIC_LOGIN_WINDOW_SECONDS=900
PUBLIC_LOGIN_MAX_ATTEMPTS=5
PUBLIC_LOGIN_GLOBAL_MAX_ATTEMPTS=20
CORS_ALLOW_ORIGINS=https://app.kaipingrc.com
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,X-Internal-Token,X-Request-ID
OUTBOUND_FETCH_HOSTS=api.eia.gov,www.eia.gov,opec.org,www.opec.org,www.ine.cn,english.czce.com.cn,www.czce.com.cn,www.chinamoney.org.cn,api.stlouisfed.org,www.cftc.gov,sanctionslist.ofac.treas.gov,sanctionslistservice.ofac.treas.gov,ofac.treasury.gov,home.treasury.gov,www.state.gov,www.consilium.europa.eu,www.ndrc.gov.cn,www.nea.gov.cn,www.ukmto.org,www.maritime.dot.gov,english.customs.gov.cn,comtradeapi.un.org,www.whitehouse.gov,press.un.org,www.iea.org,www.federalreserve.gov,www.imo.org,www.mpa.gov.sg,news.google.com,api.gdeltproject.org,www.sse.com.cn,www.szse.cn,www.hkexnews.hk,www.cninfo.com.cn,www.centcom.mil,www.defense.gov,www.war.gov,www.dvidshub.net,www.nato.int,ec.europa.eu,www.gov.uk,www.news.uscg.mil,www.aramco.com,www.adnoc.ae,www.qatarenergy.qa,www.sinopecgroup.com,www.sinopec.com,www.cnpc.com.cn,news.cnpc.com.cn,query1.finance.yahoo.com,hq.sinajs.cn,push2.eastmoney.com,www.sunsirs.com,info.texnet.com.cn,www.tnc.com.cn,zh.tradingeconomics.com,earthquake.usgs.gov,www.tradingeconomics.com,www.100ppi.com,www.cnbc.com,oilprice.com,dlpoy.100ppi.com,dldty.100ppi.com,www.visualcapitalist.com,www.eastdaley.com
INDUSTRIAL_INTELLIGENCE_ENABLED=0
INTELLIGENCE_CURSOR_SECRET=
INTELLIGENCE_RUN_DIR=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
AI_DIRECTION_REVIEW_ENABLED=0
AI_DIRECTION_REVIEW_ALLOWED_HOSTS=api.deepseek.com
AI_DIRECTION_REVIEW_TIMEOUT_SECONDS=25
AI_DIRECTION_REVIEW_DAILY_BUDGET_CNY=5
AI_DIRECTION_REVIEW_INPUT_CNY_PER_MILLION_TOKENS=2
AI_DIRECTION_REVIEW_OUTPUT_CNY_PER_MILLION_TOKENS=8
AI_DIRECTION_REVIEW_PRICE_VERSION=deepseek-config-2026-07
EIA_API_KEY=
FRED_API_KEY=
UN_COMTRADE_API_KEY=
INTRADAY_PRICE_SCHEDULER_ENABLED=true
INTRADAY_PRICE_INTERVAL_SECONDS=300
INTRADAY_PRICE_INITIAL_DELAY_SECONDS=5

# Pipeline graph cost display: static USD->CNY anchor (display-only, budget settling stays native micro-USD)
USD_CNY_DISPLAY_RATE=7.25
# USD_CNY_FX_VERSION=usd-cny-static-2026-09@7.25
