# Copy to .env.local-production for launchd on this Mac.
APP_ENV=production
ENFORCE_INTERNAL_TOKEN=1
INTERNAL_API_TOKEN=
SQLITE_PATH=server/data/agent.db
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_VERSION=fastembed-0.7.4-mean-pooling
EMBEDDING_DIMENSIONS=384
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_FALLBACK_POLICY=hash_fallback
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
RAG_CHUNK_MAX_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=120

EIA_API_KEY=
FRED_API_KEY=
UN_COMTRADE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Personal WeChat delivery is provided through a bridge service.
# Recommended: ServerChan Turbo. Alternative: PushPlus.
ALERT_PUSH_PROVIDER=serverchan
SERVERCHAN_SENDKEY=
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
PUSHPLUS_TEMPLATE=markdown

# Enterprise WeChat compatible webhook remains supported.
WECHAT_WEBHOOK_URL=
